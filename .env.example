# Copy to .env and fill in. Never commit .env.

# Model provider. "anthropic" (default) or "openai". The orchestration code is the same for both.
CD_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Models per role. Defaults are the current generation at the time of writing.
CD_MODEL_ORCHESTRATOR=claude-opus-5-5
CD_MODEL_SUBAGENT=claude-opus-5-5
CD_MODEL_OPENAI=gpt-5.2

# Data sources. All have a free tier; see README "API keys".
ETHERSCAN_API_KEY=
COINGECKO_API_KEY=
GITHUB_TOKEN=

# Web service
CD_FREE_REPORTS_PER_DAY=3
# Cap for the whole deployment, whatever the number of email addresses: bounds the daily spend.
CD_GLOBAL_REPORTS_PER_DAY=30
CD_DATA_DIR=./data
PAID_TIER_ENABLED=false
